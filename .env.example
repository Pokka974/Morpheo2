# ─── Expo Client (public, bundled into the app) ──────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Find these in: RevenueCat Dashboard → Apps → [app] → App-specific key. One key per
# app, not per project. Before any store app is configured, the Apps page offers a
# project-wide Test Store key ("test_…") instead — put it in both variables.
# NEVER the secret key ("sk_…") from the API keys page: EXPO_PUBLIC_* is inlined into
# the app bundle, so a secret set here ships in extractable form.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_<public-sdk-key>
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_<public-sdk-key>

# ─── Supabase Edge Function Secrets (server-side only) ───────────────────────
# Set via: supabase secrets set KEY=value  (never put these in .env.local)
#
# ANTHROPIC_API_KEY=sk-ant-...        # console.anthropic.com → API Keys
# FLUX_API_KEY=...                    # bfl.ai → API Keys (FLUX.1 Kontext [pro])
# LUMA_API_KEY=...                    # lumalabs.ai → API Keys (video generation, postponed)
# REVENUECAT_WEBHOOK_AUTH_HEADER=...  # RevenueCat Dashboard → Integrations → Webhooks
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically
# by the Supabase runtime — do NOT set them manually.
