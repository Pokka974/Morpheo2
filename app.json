{
  "expo": {
    "name": "Morpheo",
    "slug": "morpheo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d1a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.morpheo.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Morpheo uses Face ID to protect your dream journal.",
        "NSSpeechRecognitionUsageDescription": "Morpheo uses speech recognition for voice dream logging.",
        "NSMicrophoneUsageDescription": "Morpheo uses the microphone for voice dream logging."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0d0d1a"
      },
      "package": "com.morpheo.app",
      "permissions": [
        "RECORD_AUDIO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Morpheo uses Face ID to protect your dream journal."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#7c5cbf",
          "sounds": []
        }
      ],
      "@react-native-voice/voice",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-video",
      "expo-asset",
      "expo-font",
      "expo-localization"
    ],
    "scheme": "morpheo",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f550712-e936-457c-8359-c563a7bf04a3"
      }
    },
    "owner": "pokka97410"
  }
}
